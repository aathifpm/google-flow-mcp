# Google Flow MCP Configuration

# Mode toggle: 'api' (Veo/Imagen API) or 'web' (flow.google browser automation)
FLOW_MCP_MODE="api"

# For API Mode: Get your API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# For Web Mode: Port for Chrome remote debugging (launch Chrome with --remote-debugging-port=9222)
CHROME_DEBUG_PORT="9222"

# Base URL for Google Flow
FLOW_BASE_URL="https://flow.google/"
